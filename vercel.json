{
  "rewrites": [
    {
      "source": "/gallery/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|redditbot|Googlebot|Bingbot|SkypeUriPreview|iMessage|Applebot|Threads|Bluesky).*"
        }
      ],
      "destination": "/api/og-gallery?id=:id"
    },
    {
      "source": "/gallery/:id",
      "destination": "/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}