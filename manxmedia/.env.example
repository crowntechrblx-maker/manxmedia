# GEMINI_API_KEY: Only needed if you use Gemini AI features.
GEMINI_API_KEY=""

# ==================== SUPABASE (Database + Photo Storage) ====================
# From your Supabase project: Settings -> API
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Same URL + the PUBLIC "anon" key (safe to expose to the browser).
# These MUST be prefixed with VITE_ so the frontend build can read them.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ==================== ADMIN LOGIN ====================
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
